# 세션 서명용 임의 문자열 (32자 이상)
SESSION_SECRET=
# 계정: jdb(관리자)와 도봉·노원·성북·중랑·강북·대학·새신자·이음. 첫 로그인 때 비밀번호를 바꾼다 (시트 숨김 탭 '계정'에 해시 저장)
# 아직 비밀번호를 안 바꾼 계정이 쓰는 처음 비밀번호 (8자 이상, 비우면 처음 비밀번호 로그인 막힘)
INITIAL_PASSWORD=
# Apps Script 웹 앱 (apps-script/api.gs) 배포 URL 과, 스크립트 속성 VIEW_TOKEN 에 넣은 값
SHEET_API_URL=https://script.google.com/macros/s/.../exec
SHEET_API_TOKEN=
